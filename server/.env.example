NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/dropzone_complet

CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=0

# Au moins 32 caractères aléatoires : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Facultatives : sans elles, seul l'envoi d'images répond 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Lues seulement par `npm run create-admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Les tests lisent server/.env.test : la même chose, avec DATABASE_URL vers dropzone_complet_test.
