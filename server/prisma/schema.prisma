// Toutes les tables de DropZone. Chaque changement de ce fichier produit une
// migration (prisma/migrations), commitée puis appliquée par `prisma migrate`.
// Les contraintes CHECK et la séquence des numéros de commande sont ajoutées
// à la main dans les fichiers SQL des migrations : Prisma ne sait pas les écrire.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Les listes fermées ----------

// La sorte de produit : elle décide du formulaire du back-office
// (modèle d'appareil, options proposées, reconditionné autorisé ou non).
enum ProductKind {
  phone
  tablet
  laptop
  watch
  accessory
  audiovisual
}

enum ProductStatus {
  draft
  published
}

enum Condition {
  new
  refurbished
}

// Les listes à cocher du back-office.
enum ChoiceGroup {
  storage
  color
  ram
  processor
  keyboard
  size
  connectivity
  replaced_part
  defect
  limitation
  sim
  gpu
  origin
}

// customer : le client du site. seller (vendeur) < order_manager (responsable commande) < admin : le
// personnel du back-office, en escalier (lot 7). Les droits de chacun sont dans middlewares/access.ts.
enum Role {
  customer
  admin
  seller
  order_manager
}

// Une réservation au magasin : deux jours au plus sans avance, ou illimitée contre une avance BaridiMob (18/11).
enum ReservationMode {
  two_days
  unlimited
}

enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled
  // Un retrait au magasin (14/11) : réservé jusqu'à minuit le jour choisi, puis récupéré
  // (payé au magasin) ou expiré (le stock revient tout seul).
  reserved
  picked_up
  expired
  // Une livraison (17/11, lot 4) : « Encaissée » quand l'argent est arrivé (mouvement du journal à
  // ce jour-là, hors caisse), « Retournée » quand le client refuse le colis (stock remis, rien encaissé).
  collected
  returned
}

// Comment le client reçoit sa commande (14/11).
enum OrderType {
  delivery
  pickup
  in_store
  // Un échange (lot 5) : le client rend un téléphone (la reprise, voir TradeIn) et en prend un autre.
  exchange
}

enum PaymentMethod {
  cash
  baridimob
  ccp
  card
  transfer
}

// L'origine d'un mouvement d'argent du journal (money_movements).
enum MovementKind {
  sale
  pickup
  delivery
  exchange
  correction
  // Les frais de retour d'une livraison (17/11) : DropZone paie la société de livraison quand le
  // client refuse le colis ou ne répond pas. Toujours négatif, hors caisse (type de commande livraison).
  return_fee
}

// ---------- Le catalogue ----------

model Category {
  id       Int         @id @default(autoincrement())
  name     String      @unique
  slug     String      @unique
  kind     ProductKind @default(accessory)
  // La catégorie mise en avant sur l'accueil (grande tuile, 11/11) : une seule à la fois, garanti
  // par un index unique partiel écrit à la main dans la migration (Prisma ne sait pas l'écrire).
  featured Boolean     @default(false)
  products Product[]
  brands   Brand[]

  @@map("categories")
}

// Une marque dans une catégorie : « iPhone » dans Smartphones, « MacBook » dans PC
// portables. Une même entreprise a donc une ligne par catégorie, avec son nom affiché.
model Brand {
  id            Int              @id @default(autoincrement())
  categoryId    Int              @map("category_id")
  // Supprimer une catégorie supprime ses marques : elle n'est supprimable que sans
  // produits (RESTRICT sur products.category_id), donc ses marques n'en ont pas.
  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  // Le fabricant des modèles d'appareils (champ `brand` de DeviceModel), pour
  // remplir la marque d'un produit depuis son modèle : « Apple » pour « iPhone ».
  makerName     String?          @map("maker_name")
  // « /brands/apple.svg » (bibliothèque Simple Icons) ou une URL Cloudinary.
  logoUrl       String?          @map("logo_url")
  // Plus utilisées depuis le 11/11 (choix de Mehdi : la tuile d'une marque montre son logo, pas
  // de photo). À supprimer par une migration séparée, une fois ce code en ligne : dans la même
  // livraison, l'ancienne API encore en route les lirait après la migration, le temps du déploiement.
  photoUrl      String?          @map("photo_url")
  photoPublicId String?          @map("photo_public_id")
  position      Int              @default(0)
  createdAt     DateTime         @default(now()) @map("created_at")
  products      Product[]
  // Supprimer une marque qui a des séries est refusé (RESTRICT) : le gérant les supprime d'abord.
  series        Series[]
  // Dans une catégorie d'accessoires, la ligne est un type (Chargeurs, Coques…) et ses marques
  // (Apple, Samsung, Anker) sont ses `makers` : l'étape marque de la Boutique (12/11).
  makers        AccessoryMaker[]

  @@unique([categoryId, slug])
  @@map("brands")
}

// La marque d'un accessoire, dans un type d'accessoires : « Anker » dans Chargeurs, « iPhone »
// dans Coques. Comme les marques d'appareils, une même entreprise a une ligne par type. Un type
// supprimé emporte ses marques ; une marque utilisée par un produit ne se supprime pas (RESTRICT
// sur products.maker_id).
model AccessoryMaker {
  id        Int       @id @default(autoincrement())
  typeId    Int       @map("type_id")
  type      Brand     @relation(fields: [typeId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  // « /brands/anker.svg » (bibliothèque) ou une URL Cloudinary.
  logoUrl   String?   @map("logo_url")
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@unique([typeId, slug])
  @@map("accessory_makers")
}

// Une série d'une marque (« iPhone 18 » chez iPhone, « MacBook Air » chez MacBook) :
// la Boutique en fait une affiche, avec tous ses modèles côte à côte.
model Series {
  id        Int           @id @default(autoincrement())
  brandId   Int           @map("brand_id")
  brand     Brand         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  name      String
  slug      String
  // L'image de l'affiche, envoyée par le gérant (Cloudinary) ; sans elle, l'affiche de secours.
  coverUrl  String?       @map("cover_url")
  createdAt DateTime      @default(now()) @map("created_at")
  models    DeviceModel[]

  @@unique([brandId, slug])
  @@map("series")
}

model DeviceModel {
  id                 Int               @id @default(autoincrement())
  brand              String
  name               String
  slug               String            @unique
  kind               ProductKind
  // L'année de sortie : la Boutique range les modèles du plus récent au plus ancien.
  // Facultative pour les modèles créés avant ; ceux sans année passent à la fin.
  releaseYear        Int?              @map("release_year")
  // La série du modèle (null = sans série, invisible dans la Boutique), sa place dans
  // l'affiche et la couleur de sa lueur (un nom de la liste « Couleurs »).
  seriesId           Int?              @map("series_id")
  series             Series?           @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesPosition     Int               @default(0) @map("series_position")
  // Les couleurs officielles du modèle, dans le monde (noms de la liste « Couleurs »),
  // sans rapport avec le stock : les pastilles de l'affiche (décision de Mehdi du 05/11).
  colors             String[]          @default([])
  // La lueur choisie par le gérant, une de `colors` ; null = la première de `colors`.
  posterColor        String?           @map("poster_color")
  // La photo de chaque couleur (étape Couleur de la Boutique) ; sans photo, l'icône.
  colorPhotos        ModelColorPhoto[]
  // Un produit au plus par modèle (index unique partiel écrit à la main dans la migration
  // 20261105150000_color_photos : Prisma ne sait pas le déclarer). Tableau gardé pour Prisma.
  products           Product[]         @relation("ProductDeviceModel")
  compatibleProducts Product[]         @relation("ProductCompatibleModels")
  // Les variantes d'accessoires qui vont sur ce modèle (une taille de verre, 12/11).
  compatibleVariants ProductVariant[]  @relation("VariantCompatibleModels")
  // Les téléphones repris en échange (lot 5) : un modèle repris ne se supprime pas.
  tradeIns           TradeIn[]
  createdAt          DateTime          @default(now()) @map("created_at")

  @@unique([brand, name])
  @@index([kind])
  @@index([seriesId])
  @@map("device_models")
}

// La photo d'une couleur d'un modèle (« iPhone 18 Pro » en « Glacier »), sans rapport avec
// le stock : elle sert à toutes ses fiches. Envoyée par le gérant (Cloudinary).
model ModelColorPhoto {
  id            Int         @id @default(autoincrement())
  deviceModelId Int         @map("device_model_id")
  deviceModel   DeviceModel @relation(fields: [deviceModelId], references: [id], onDelete: Cascade)
  // Un nom de `device_models.colors`.
  color         String
  url           String
  publicId      String?     @map("public_id")

  @@unique([deviceModelId, color])
  @@map("model_color_photos")
}

model Choice {
  id     Int          @id @default(autoincrement())
  group  ChoiceGroup?
  listId Int?         @map("list_id")
  list   ChoiceList?  @relation(fields: [listId], references: [id], onDelete: Cascade)
  label  String
  // La teinte d'une couleur (« #f47d3c »), réglée par le gérant dans Listes : la pastille
  // et la lueur de l'affiche la lisent. Seulement pour la liste des couleurs (CHECK).
  hex    String?

  @@unique([group, label])
  @@unique([listId, label])
  @@map("choices")
}

model ChoiceList {
  id       Int           @id @default(autoincrement())
  name     String        @unique
  group    ChoiceGroup?  @unique
  kinds    ProductKind[] @default([])
  multiple Boolean       @default(false)
  choices  Choice[]

  @@map("choice_lists")
}

model Product {
  id               Int              @id @default(autoincrement())
  name             String
  slug             String           @unique
  description      String
  categoryId       Int              @map("category_id")
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  deviceModelId    Int?             @map("device_model_id")
  deviceModel      DeviceModel?     @relation("ProductDeviceModel", fields: [deviceModelId], references: [id], onDelete: Restrict)
  // Facultative : un câble générique n'a pas de marque. Une marque utilisée ne se supprime pas.
  brandId          Int?             @map("brand_id")
  brand            Brand?           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  // Un accessoire : sa marque dans son type (Anker dans Chargeurs). Règle de l'API : la marque
  // appartient au type du produit (`brandId`).
  makerId          Int?             @map("maker_id")
  maker            AccessoryMaker?  @relation(fields: [makerId], references: [id], onDelete: Restrict)
  compatibleModels DeviceModel[]    @relation("ProductCompatibleModels")
  specs            Json             @default("{}")
  status           ProductStatus    @default(draft)
  minPrice         Int              @default(0) @map("min_price")
  newPrice         Int?             @map("new_price")
  createdAt        DateTime         @default(now()) @map("created_at")
  // Le dernier arrivage (12/11) : la création, puis chaque nouvel exemplaire, nouvelle variante ou
  // hausse de stock faits dans le back-office. Les « derniers arrivages » de l'accueil le suivent.
  stockedAt        DateTime         @default(now()) @map("stocked_at")
  variants         ProductVariant[]
  images           ProductImage[]
  orderItems       OrderItem[]

  @@index([status, categoryId, createdAt(sort: Desc)])
  @@index([status, stockedAt(sort: Desc)])
  @@index([status, minPrice])
  @@index([newPrice])
  @@index([categoryId])
  @@index([deviceModelId])
  @@index([brandId])
  @@index([makerId])
  @@map("products")
}

model ProductVariant {
  id               Int           @id @default(autoincrement())
  productId        Int           @map("product_id")
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku              String        @unique
  options          Json          @default("{}")
  price            Int
  // Le prix d'achat du magasin (14/11), admin seulement, jamais montré sur le site.
  purchasePrice    Int?          @map("purchase_price")
  stock            Int
  stockedAt        DateTime      @default(now()) @map("stocked_at")
  condition        Condition     @default(new)
  // La fiche d'état d'une affaire (`refurbished`), vide pour un neuf scellé (`new`).
  grade            Int?
  batteryHealth    Int?          @map("battery_health")
  replacedParts    String[]      @default([]) @map("replaced_parts")
  // Les pièces changées qui ne sont pas d'origine (CHECK : une partie de replacedParts).
  compatibleParts  String[]      @default([]) @map("compatible_parts")
  defects          String[]      @default([])
  limitations      String[]      @default([])
  // Avec (true) ou sans (false) sa boîte d'origine. Une affaire importée d'une annonce
  // qui n'en parle pas reste à null (« Boîte non précisée ») ; un neuf scellé est
  // toujours à null, il l'a par définition (CHECK dans la migration).
  withBox          Boolean?      @map("with_box")
  // Les détails du gérant pour le client (« Comme neuf, vendu avec sa boîte d'origine »).
  details          String?
  // La garantie en mois (CHECK : 1 à 36), obligatoire pour un appareil (règle de l'API).
  warrantyMonths   Int?          @map("warranty_months")
  // Le pays d'origine, une valeur de la liste « Pays d'origine » (« Europe »).
  origin           String?
  // La référence interne du magasin (« 51057 »), unique quand elle existe.
  reference        String?       @unique
  // Les téléphones sur lesquels va cette variante d'accessoire (une taille de verre : 6,7 pouces),
  // réglés dans le back-office et montrés par la fenêtre de la Boutique (12/11).
  compatibleModels DeviceModel[] @relation("VariantCompatibleModels")
  // Les articles offerts avec cette variante (neuf scellé ou affaire).
  gifts            VariantGift[] @relation("DealVariant")
  // Les affaires dans lesquelles cette variante est offerte.
  giftedIn         VariantGift[] @relation("GiftVariant")

  @@index([productId])
  @@index([stockedAt(sort: Desc)])
  @@map("product_variants")
}

model VariantGift {
  id            Int            @id @default(autoincrement())
  variantId     Int            @map("variant_id")
  variant       ProductVariant @relation("DealVariant", fields: [variantId], references: [id], onDelete: Cascade)
  giftVariantId Int            @map("gift_variant_id")
  giftVariant   ProductVariant @relation("GiftVariant", fields: [giftVariantId], references: [id], onDelete: Cascade)
  quantity      Int            @default(1)

  @@unique([variantId, giftVariantId])
  @@index([giftVariantId])
  @@map("variant_gifts")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String? @map("public_id")
  position  Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

// La mémoire de l'import des annonces (`npm run import:dropzone`) : pour chaque SKU
// importé, les valeurs de la dernière annonce écrite. Sans lien vers la variante, exprès :
// une ligne survit à la suppression de la variante, et l'import sait alors que le gérant
// l'a retirée (il ne la recrée pas). Au rejeu, seuls les champs dont l'annonce a changé
// depuis cette mémoire sont réécrits : les corrections du gérant restent.
model ImportRecord {
  sku       String   @id
  snapshot  Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("import_records")
}

// ---------- Les comptes ----------

model User {
  id             Int      @id @default(autoincrement())
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  phone          String
  role           Role     @default(customer)
  // Un compte désactivé est refusé à la requête suivante, sans être supprimé : les ventes et les traces
  // gardent son nom (lot 7).
  disabled       Boolean  @default(false)
  // Monte quand les sessions ouvertes doivent être coupées (mot de passe réinitialisé, compte désactivé).
  // Le jeton de connexion le porte ; jamais renvoyé par l'API (voir `omit` dans config/db.ts).
  tokenVersion   Int      @default(0) @map("token_version")
  addressWilaya  String?  @map("address_wilaya")
  addressCommune String?  @map("address_commune")
  addressLine    String?  @map("address_line")
  createdAt      DateTime @default(now()) @map("created_at")
  orders         Order[]

  @@map("users")
}

// ---------- Les commandes ----------

model Order {
  id                  Int         @id @default(autoincrement())
  // Une deuxième séquence, pour le numéro montré au client. Elle commence à 1001
  // (réglé à la main dans la migration add_store_tables).
  number              Int         @unique @default(autoincrement())
  userId              Int?        @map("user_id")
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName            String      @map("full_name")
  phone               String
  // Le type de commande (14/11). Une livraison a toujours son adresse ; un retrait a son jour,
  // son heure et sa fin de réservation (CHECK dans la migration 20261114090000).
  type                OrderType   @default(delivery)
  // Le numéro du jour (repart à 1 à minuit, heure d'Alger) et ce jour-là.
  dailyNumber         Int         @map("daily_number")
  businessDate        DateTime    @map("business_date") @db.Date
  wilaya              String?
  commune             String?
  address             String?
  pickupDate          DateTime?   @map("pickup_date") @db.Date
  // L'heure annoncée par le client (« 14:30 »).
  pickupTime          String?     @map("pickup_time")
  // Minuit à Alger le soir de pickupDate : après, la réservation expire.
  reservedUntil       DateTime?   @map("reserved_until")
  // La réservation illimitée avec avance BaridiMob (18/11). `reservationMode` : null pour une livraison, une
  // vente ou un échange ; « two_days » (la réservation de deux jours, sans avance) ou « unlimited » pour un
  // retrait. `advanceAmount` : l'avance demandée, copiée des réglages à la commande (un fait passé).
  // `baridiNumber` : le numéro BaridiMob copié des réglages au moment où le magasin l'envoie au client
  // (`baridiSharedAt`) : le client ne le voit qu'à partir de là. `advancePaidAt` : l'avance est reçue.
  reservationMode     ReservationMode? @map("reservation_mode")
  advanceAmount       Int?        @map("advance_amount")
  baridiNumber        String?     @map("baridi_number")
  baridiSharedAt      DateTime?   @map("baridi_shared_at")
  advancePaidAt       DateTime?   @map("advance_paid_at")
  subtotal            Int
  shippingFee         Int         @map("shipping_fee")
  total               Int
  status              OrderStatus @default(pending)
  note                String?
  limitationsAccepted Boolean     @default(false) @map("limitations_accepted")
  createdAt           DateTime    @default(now()) @map("created_at")
  items               OrderItem[]
  // Le téléphone que le client a rendu, pour un échange (lot 5).
  tradeIn             TradeIn?
  // La facture (lot 6) : son numéro est attribué à la PREMIÈRE ouverture et ne change plus. Une suite
  // continue par année (F-2026-0001…), voir InvoiceCounter. null = pas encore de facture.
  invoiceNumber       Int?        @map("invoice_number")
  invoiceYear         Int?        @map("invoice_year")
  invoiceIssuedAt     DateTime?   @map("invoice_issued_at")

  @@unique([invoiceYear, invoiceNumber])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, reservedUntil])
  @@index([businessDate])
  @@map("orders")
}

// Le téléphone repris dans un échange (lot 5). Il attend ici, hors du catalogue, tant que l'admin n'a
// pas fixé son prix de revente : aucune lecture du site n'a donc à l'écarter. « Mettre en vente »
// en fait une affaire dans la fiche de son modèle (`listedAt` et `listedVariantId` le disent).
model TradeIn {
  id              Int         @id @default(autoincrement())
  orderId         Int         @unique @map("order_id")
  // L'échange disparaît avec sa suppression (refusée par le service si la reprise est déjà en vente).
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deviceModelId   Int         @map("device_model_id")
  deviceModel     DeviceModel @relation(fields: [deviceModelId], references: [id], onDelete: Restrict)
  color           String
  // La fiche d'état saisie à l'échange (note, batterie, pièces, défauts, limitations, boîte, garantie,
  // origine, détails, options), validée par l'API : recopiée telle quelle sur l'affiche à la mise en vente.
  sheet           Json        @default("{}")
  // Le prix de reprise, saisi à la main par le magasin : ce que le client reçoit pour son téléphone,
  // et le prix d'achat de l'affaire une fois en vente.
  price           Int
  // Ce que la remise en état a coûté (batterie neuve…), saisi avant la mise en vente (18/11) : il
  // s'ajoute au prix d'achat de l'affaire, donc au bénéfice de sa revente.
  repairCost      Int         @default(0) @map("repair_cost")
  createdAt       DateTime    @default(now()) @map("created_at")
  // Mise en vente : la date, et la variante créée (sans clé étrangère : la trace survit à sa suppression).
  listedAt        DateTime?   @map("listed_at")
  listedVariantId Int?        @map("listed_variant_id")

  @@index([listedAt])
  @@index([deviceModelId])
  @@map("trade_ins")
}

model OrderItem {
  id              Int       @id @default(autoincrement())
  orderId         Int       @map("order_id")
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       Int?      @map("product_id")
  product         Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Recopiés à la commande : une commande est un fait passé.
  sku             String
  name            String
  options         Json      @default("{}")
  condition       Condition @default(new)
  conditionReport String?   @map("condition_report")
  unitPrice       Int       @map("unit_price")
  quantity        Int
  isGift          Boolean   @default(false) @map("is_gift")
  // La garantie de l'appareil au jour de la commande (null pour un accessoire).
  warrantyMonths  Int?      @map("warranty_months")
  // Le prix d'achat de la variante au moment de la vente (14/11) : le bénéfice passé ne
  // change jamais, même quand le prix d'achat change ensuite. null = inconnu.
  unitCost        Int?      @map("unit_cost")
  // Le prix catalogue au moment de la commande (16/11, lot 3) et qui a accordé le prix actuel
  // quand il en diffère. `unitPrice` est le prix accordé : la caisse et les totaux le comptent.
  // null = commande d'avant le lot 3, dont le prix catalogue n'est pas connu. Pas de clé étrangère
  // sur `grantedById`, comme `userId` des mouvements : la trace survit à un compte supprimé.
  listPrice       Int?      @map("list_price")
  grantedById     Int?      @map("granted_by_id")
  // Les réparations ouvertes pour cet article (garantie, étape 2 de l'atelier).
  repairs         Repair[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Les photos du socle de l'accueil (06/11) : le hero (`hero`) et le bandeau des affaires
// (`deal`) ont chacun leurs emplacements fixes (`slot`, liste dans stage.slots.ts). Le gérant y
// envoie ses photos sans fond depuis le back-office (page Accueil) ; un emplacement sans ligne
// garde l'illustration de départ.
model StageSlot {
  id       Int     @id @default(autoincrement())
  stage    String
  slot     String
  url      String?
  label    String?
  publicId String? @map("public_id")
  // La place choisie à la souris ou au doigt (06/11), en % du cadre du socle : `x` le bord
  // gauche, `y` la hauteur du bas de la photo, `w` la largeur ; `z` l'ordre (devant/derrière).
  // Null : la place de départ de l'emplacement (stageLayout.ts du front).
  x        Float?
  y        Float?
  w        Float?
  z        Int?

  @@unique([stage, slot])
  @@map("stage_slots")
}

// ---------- Le magasin : journée, caisse, argent (14/11) ----------

// Le compteur du numéro du jour : une ligne par journée d'Alger.
model DailyCounter {
  date  DateTime @id @db.Date
  value Int

  @@map("daily_counters")
}

// La journée de caisse : ouverte avec un fond, fermée avec le montant compté.
model CashDay {
  id           Int       @id @default(autoincrement())
  date         DateTime  @unique @db.Date
  openingFloat Int       @map("opening_float")
  countedCash  Int?      @map("counted_cash")
  openedAt     DateTime  @default(now()) @map("opened_at")
  closedAt     DateTime? @map("closed_at")
  openedById   Int?      @map("opened_by_id")
  closedById   Int?      @map("closed_by_id")

  @@map("cash_days")
}

// Chaque réouverture d'une caisse fermée (15/11) : qui, quand, et le comptage qu'on a effacé.
// Sans cette trace, on pourrait cacher un écart en rouvrant puis en refermant avec un autre montant.
model CashReopening {
  id                  Int       @id @default(autoincrement())
  createdAt           DateTime  @default(now()) @map("created_at")
  businessDate        DateTime  @map("business_date") @db.Date
  userId              Int?      @map("user_id")
  previousCountedCash Int?      @map("previous_counted_cash")
  previousClosedAt    DateTime? @map("previous_closed_at")

  @@index([businessDate])
  @@map("cash_reopenings")
}

// Le journal des mouvements d'argent : une ligne par entrée (+) ou sortie (−), jamais
// modifiée. La caisse, les livraisons et l'historique se calculent à partir de lui.
model MoneyMovement {
  id           Int           @id @default(autoincrement())
  createdAt    DateTime      @default(now()) @map("created_at")
  businessDate DateTime      @map("business_date") @db.Date
  amount       Int
  method       PaymentMethod
  kind         MovementKind
  orderId      Int?          @map("order_id")
  userId       Int?          @map("user_id")
  note         String?
  // Le type de la commande qui a produit ce mouvement (17/11, lot 4), recopié : il survit à la
  // suppression de la commande. Il décide de la caisse (l'argent d'une livraison n'entre jamais
  // dans le tiroir) et de l'onglet de l'historique (Magasin, Livraisons, Réservations).
  orderType    OrderType?    @map("order_type")

  @@index([businessDate])
  @@index([orderId])
  @@map("money_movements")
}

// Ce que l'admin a fait à une commande après coup (15/11, lot 2).
enum OrderEventKind {
  edited
  deleted
}

// Le journal des modifications et suppressions de commande. `orderId` n'a PAS de clé étrangère :
// la trace doit survivre à la suppression de sa commande. Une ligne n'est jamais modifiée.
model OrderEvent {
  id          Int            @id @default(autoincrement())
  createdAt   DateTime       @default(now()) @map("created_at")
  kind        OrderEventKind
  orderId     Int?           @map("order_id")
  orderNumber Int            @map("order_number")
  userId      Int?           @map("user_id")
  summary     String
  // La différence d'argent de cette modification (négative pour une baisse ou un remboursement).
  amountDelta Int            @default(0) @map("amount_delta")
  // Le type de la commande, recopié (17/11) : l'historique montre les modifications de l'onglet
  // choisi (Magasin, Livraisons, Réservations). null = trace d'avant, dont la commande a disparu :
  // elle ne se voit que dans le Total.
  orderType   OrderType?     @map("order_type")

  @@index([createdAt])
  @@index([orderId])
  @@map("order_events")
}

// Les réglages du magasin : une seule ligne (id = 1). closedDays : 0 = dimanche … 6 = samedi.
model StoreSettings {
  id          Int    @id @default(1)
  openingTime String @default("09:00") @map("opening_time")
  closingTime String @default("20:00") @map("closing_time")
  closedDays  Int[]  @default([]) @map("closed_days")
  // La réservation illimitée (18/11) : l'avance en dinars (0 = l'offre est coupée) et le numéro BaridiMob sur
  // lequel le client l'envoie. Réglés par l'admin ; le numéro n'est jamais public, il est copié sur la
  // commande quand le magasin l'envoie au client.
  reservationAdvance Int    @default(0) @map("reservation_advance")
  baridiNumber       String @default("") @map("baridi_number")

  @@map("store_settings")
}

// Ce qui s'imprime en tête et en bas d'une facture (lot 6) : une seule ligne (id = 1), remplie par l'admin
// dans Réglages › Facture. Un champ vide n'apparaît pas sur la facture. À faire vérifier par le comptable
// de DropZone avant usage réel (statut juridique inconnu).
model InvoiceSettings {
  id             Int     @id @default(1)
  shopName       String  @default("DropZone") @map("shop_name")
  legalForm      String  @default("") @map("legal_form")
  address        String  @default("")
  phones         String  @default("")
  email          String  @default("")
  instagram      String  @default("")
  registerNumber String  @default("") @map("register_number")
  nif            String  @default("")
  nis            String  @default("")
  taxArticle     String  @default("") @map("tax_article")
  rib            String  @default("")
  // Les conditions de garantie et de retour, et la note de bas de page.
  warrantyTerms  String  @default("") @map("warranty_terms")
  footerNote     String  @default("") @map("footer_note")
  // La TVA, éteinte par défaut : tant que le statut du magasin n'est pas connu, aucun taux n'est inventé.
  vatEnabled     Boolean @default(false) @map("vat_enabled")
  vatRate        Int     @default(19) @map("vat_rate")

  @@map("invoice_settings")
}

// Le compteur de la suite des factures : une ligne par année, comme `daily_counters` pour les numéros du
// jour. Incrémenté en une seule requête atomique (voir invoiceNumber.ts).
model InvoiceCounter {
  year  Int @id
  value Int

  @@map("invoice_counters")
}

// ---------- L'atelier : les pièces (18/11, étape 1) ----------

// Ce qui a fait bouger le stock d'une pièce. D'autres valeurs viendront avec l'étape qui s'en sert (la sortie
// d'une réparation, le démontage d'un appareil).
enum PartMovementKind {
  // Des pièces reçues : le prix d'achat unitaire est dans le mouvement, et le prix d'achat de la pièce devient
  // la moyenne pondérée (partMath.ts).
  arrival
  // Le stock compté par l'admin : le mouvement porte l'écart.
  correction
  // Une pièce sortie du stock quand la réparation passe « En réparation » (étape 2) : delta négatif, `repairId`
  // et `note` (« R-1001 ») disent laquelle.
  repair
  // Une pièce remise au stock : devis refusé, fiche supprimée, ligne retirée ou diminuée après sa sortie.
  repair_return
}

// Une pièce de l'atelier (batterie, écran…) : ce qu'elle a coûté, à quel prix on la vend, combien il en reste.
// Les CHECK (stock et prix jamais négatifs) et l'unicité du nom sans casse ni espaces
// (`lower(btrim(name))`) sont dans la migration : Prisma ne sait pas les décrire. Aucune suppression : le
// journal doit garder la trace de chaque pièce.
model Part {
  id            Int            @id @default(autoincrement())
  name          String
  purchasePrice Int            @map("purchase_price")
  salePrice     Int            @map("sale_price")
  stock         Int            @default(0)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")
  movements     PartMovement[]
  repairParts   RepairPart[]

  @@map("parts")
}

// Le journal du stock d'une pièce : une ligne par arrivage ou correction, jamais modifiée ni supprimée.
// `stockAfter` : le stock juste après, pour relire l'histoire sans la recalculer.
model PartMovement {
  id         Int              @id @default(autoincrement())
  createdAt  DateTime         @default(now()) @map("created_at")
  partId     Int              @map("part_id")
  part       Part             @relation(fields: [partId], references: [id], onDelete: Restrict)
  kind       PartMovementKind
  delta      Int
  unitCost   Int?             @map("unit_cost")
  stockAfter Int              @map("stock_after")
  // Pas de clé étrangère : la trace survit à un compte supprimé, comme `userId` des mouvements d'argent.
  userId     Int?             @map("user_id")
  note       String?
  // La fiche d'un mouvement `repair` ou `repair_return` : sans clé étrangère, la trace survit à la suppression
  // de la fiche.
  repairId   Int?             @map("repair_id")

  @@index([partId])
  @@map("part_movements")
}

// ---------- L'atelier : les fiches de réparation (18/11, étape 2) ----------

// Où en est un appareil confié au magasin. Reçu : au magasin. Devis à valider : le prix est fixé, le client doit
// répondre. En réparation : accepté, les pièces sont sorties du stock. Prêt : il attend le client. À rendre sans
// réparation : le client a refusé le devis. Rendu : le client l'a récupéré.
enum RepairStatus {
  received
  quote
  in_repair
  ready
  to_return
  returned
}

// Un appareil confié à l'atelier. Les CHECK (main-d'œuvre jamais négative, garantie toujours datée) sont dans la
// migration. Aucun code de déverrouillage n'est stocké : c'est une donnée sensible du client.
model Repair {
  id                Int           @id @default(autoincrement())
  // Le numéro montré au client (R-1001…) : une séquence à part de celle des commandes, réglée à 1001 dans la
  // migration.
  number            Int           @unique @default(autoincrement())
  status            RepairStatus  @default(received)
  fullName          String        @map("full_name")
  phone             String
  deviceName        String        @map("device_name")
  deviceColor       String?       @map("device_color")
  deviceState       String?       @map("device_state")
  issue             String
  accessories       String?
  // La main-d'œuvre, saisie à la main ; null tant que le technicien n'a pas regardé la panne.
  laborPrice        Int?          @map("labor_price")
  // La note du technicien : jamais montrée au client.
  note              String?
  // La garantie est un fait écrit à la création : `underWarranty` est vrai seulement avec un article d'origine
  // dans les délais et sans « forcer hors garantie ».
  underWarranty     Boolean       @map("under_warranty")
  warrantyEndsAt    DateTime?     @map("warranty_ends_at") @db.Date
  warrantyForcedOff Boolean       @default(false) @map("warranty_forced_off")
  // L'article de la vente d'origine ; si la commande est supprimée, la fiche reste (le numéro copié aussi).
  originItemId      Int?          @map("origin_item_id")
  originItem        OrderItem?    @relation(fields: [originItemId], references: [id], onDelete: SetNull)
  originOrderNumber Int?          @map("origin_order_number")
  // Pas de clé étrangère : la trace survit à un compte supprimé.
  createdById       Int?          @map("created_by_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at")
  parts             RepairPart[]
  events            RepairEvent[]

  @@index([status, createdAt(sort: Desc)])
  @@index([phone])
  @@map("repairs")
}

// Une pièce d'une fiche. Nom et prix sont COPIÉS de la pièce au moment de l'ajout (cahier §4) : changer la pièce
// ensuite ne change jamais une réparation passée. `consumed` : la pièce est déjà sortie du stock.
model RepairPart {
  id        Int     @id @default(autoincrement())
  repairId  Int     @map("repair_id")
  repair    Repair  @relation(fields: [repairId], references: [id], onDelete: Cascade)
  partId    Int     @map("part_id")
  part      Part    @relation(fields: [partId], references: [id], onDelete: Restrict)
  name      String
  quantity  Int
  unitCost  Int     @map("unit_cost")
  unitPrice Int     @map("unit_price")
  consumed  Boolean @default(false)

  @@unique([repairId, partId])
  @@index([repairId])
  @@map("repair_parts")
}

// Chaque changement d'étape : qui, quand. Ces dates alimenteront le suivi du client (étape 4).
model RepairEvent {
  id        Int          @id @default(autoincrement())
  repairId  Int          @map("repair_id")
  repair    Repair       @relation(fields: [repairId], references: [id], onDelete: Cascade)
  status    RepairStatus
  userId    Int?         @map("user_id")
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([repairId])
  @@map("repair_events")
}
