// Toutes les tables de DropZone. Chaque changement de ce fichier produit une
// migration (prisma/migrations), commitée puis appliquée par `prisma migrate`.
// Les contraintes CHECK et la séquence des numéros de commande sont ajoutées
// à la main dans les fichiers SQL des migrations : Prisma ne sait pas les écrire.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Les listes fermées ----------

// La sorte de produit : elle décide du formulaire du back-office
// (modèle d'appareil, options proposées, reconditionné autorisé ou non).
enum ProductKind {
  phone
  tablet
  laptop
  watch
  accessory
  audiovisual
}

enum ProductStatus {
  draft
  published
}

enum Condition {
  new
  refurbished
}

// Les listes à cocher du back-office.
enum ChoiceGroup {
  storage
  color
  ram
  processor
  keyboard
  size
  connectivity
  replaced_part
  defect
  limitation
  sim
  gpu
  origin
}

enum Role {
  customer
  admin
}

enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled
}

// ---------- Le catalogue ----------

model Category {
  id       Int         @id @default(autoincrement())
  name     String      @unique
  slug     String      @unique
  kind     ProductKind @default(accessory)
  // La catégorie mise en avant sur l'accueil (grande tuile, 11/11) : une seule à la fois, garanti
  // par un index unique partiel écrit à la main dans la migration (Prisma ne sait pas l'écrire).
  featured Boolean     @default(false)
  products Product[]
  brands   Brand[]

  @@map("categories")
}

// Une marque dans une catégorie : « iPhone » dans Smartphones, « MacBook » dans PC
// portables. Une même entreprise a donc une ligne par catégorie, avec son nom affiché.
model Brand {
  id            Int              @id @default(autoincrement())
  categoryId    Int              @map("category_id")
  // Supprimer une catégorie supprime ses marques : elle n'est supprimable que sans
  // produits (RESTRICT sur products.category_id), donc ses marques n'en ont pas.
  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  // Le fabricant des modèles d'appareils (champ `brand` de DeviceModel), pour
  // remplir la marque d'un produit depuis son modèle : « Apple » pour « iPhone ».
  makerName     String?          @map("maker_name")
  // « /brands/apple.svg » (bibliothèque Simple Icons) ou une URL Cloudinary.
  logoUrl       String?          @map("logo_url")
  // Plus utilisées depuis le 11/11 (choix de Mehdi : la tuile d'une marque montre son logo, pas
  // de photo). À supprimer par une migration séparée, une fois ce code en ligne : dans la même
  // livraison, l'ancienne API encore en route les lirait après la migration, le temps du déploiement.
  photoUrl      String?          @map("photo_url")
  photoPublicId String?          @map("photo_public_id")
  position      Int              @default(0)
  createdAt     DateTime         @default(now()) @map("created_at")
  products      Product[]
  // Supprimer une marque qui a des séries est refusé (RESTRICT) : le gérant les supprime d'abord.
  series        Series[]
  // Dans une catégorie d'accessoires, la ligne est un type (Chargeurs, Coques…) et ses marques
  // (Apple, Samsung, Anker) sont ses `makers` : l'étape marque de la Boutique (12/11).
  makers        AccessoryMaker[]

  @@unique([categoryId, slug])
  @@map("brands")
}

// La marque d'un accessoire, dans un type d'accessoires : « Anker » dans Chargeurs, « iPhone »
// dans Coques. Comme les marques d'appareils, une même entreprise a une ligne par type. Un type
// supprimé emporte ses marques ; une marque utilisée par un produit ne se supprime pas (RESTRICT
// sur products.maker_id).
model AccessoryMaker {
  id        Int       @id @default(autoincrement())
  typeId    Int       @map("type_id")
  type      Brand     @relation(fields: [typeId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  // « /brands/anker.svg » (bibliothèque) ou une URL Cloudinary.
  logoUrl   String?   @map("logo_url")
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@unique([typeId, slug])
  @@map("accessory_makers")
}

// Une série d'une marque (« iPhone 18 » chez iPhone, « MacBook Air » chez MacBook) :
// la Boutique en fait une affiche, avec tous ses modèles côte à côte.
model Series {
  id        Int           @id @default(autoincrement())
  brandId   Int           @map("brand_id")
  brand     Brand         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  name      String
  slug      String
  // L'image de l'affiche, envoyée par le gérant (Cloudinary) ; sans elle, l'affiche de secours.
  coverUrl  String?       @map("cover_url")
  createdAt DateTime      @default(now()) @map("created_at")
  models    DeviceModel[]

  @@unique([brandId, slug])
  @@map("series")
}

model DeviceModel {
  id                 Int               @id @default(autoincrement())
  brand              String
  name               String
  slug               String            @unique
  kind               ProductKind
  // L'année de sortie : la Boutique range les modèles du plus récent au plus ancien.
  // Facultative pour les modèles créés avant ; ceux sans année passent à la fin.
  releaseYear        Int?              @map("release_year")
  // La série du modèle (null = sans série, invisible dans la Boutique), sa place dans
  // l'affiche et la couleur de sa lueur (un nom de la liste « Couleurs »).
  seriesId           Int?              @map("series_id")
  series             Series?           @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesPosition     Int               @default(0) @map("series_position")
  // Les couleurs officielles du modèle, dans le monde (noms de la liste « Couleurs »),
  // sans rapport avec le stock : les pastilles de l'affiche (décision de Mehdi du 05/11).
  colors             String[]          @default([])
  // La lueur choisie par le gérant, une de `colors` ; null = la première de `colors`.
  posterColor        String?           @map("poster_color")
  // La photo de chaque couleur (étape Couleur de la Boutique) ; sans photo, l'icône.
  colorPhotos        ModelColorPhoto[]
  // Un produit au plus par modèle (index unique partiel écrit à la main dans la migration
  // 20261105150000_color_photos : Prisma ne sait pas le déclarer). Tableau gardé pour Prisma.
  products           Product[]         @relation("ProductDeviceModel")
  compatibleProducts Product[]         @relation("ProductCompatibleModels")
  // Les variantes d'accessoires qui vont sur ce modèle (une taille de verre, 12/11).
  compatibleVariants ProductVariant[]  @relation("VariantCompatibleModels")
  createdAt          DateTime          @default(now()) @map("created_at")

  @@unique([brand, name])
  @@index([kind])
  @@index([seriesId])
  @@map("device_models")
}

// La photo d'une couleur d'un modèle (« iPhone 18 Pro » en « Glacier »), sans rapport avec
// le stock : elle sert à toutes ses fiches. Envoyée par le gérant (Cloudinary).
model ModelColorPhoto {
  id            Int         @id @default(autoincrement())
  deviceModelId Int         @map("device_model_id")
  deviceModel   DeviceModel @relation(fields: [deviceModelId], references: [id], onDelete: Cascade)
  // Un nom de `device_models.colors`.
  color         String
  url           String
  publicId      String?     @map("public_id")

  @@unique([deviceModelId, color])
  @@map("model_color_photos")
}

model Choice {
  id     Int          @id @default(autoincrement())
  group  ChoiceGroup?
  listId Int?         @map("list_id")
  list   ChoiceList?  @relation(fields: [listId], references: [id], onDelete: Cascade)
  label  String
  // La teinte d'une couleur (« #f47d3c »), réglée par le gérant dans Listes : la pastille
  // et la lueur de l'affiche la lisent. Seulement pour la liste des couleurs (CHECK).
  hex    String?

  @@unique([group, label])
  @@unique([listId, label])
  @@map("choices")
}

model ChoiceList {
  id       Int           @id @default(autoincrement())
  name     String        @unique
  group    ChoiceGroup?  @unique
  kinds    ProductKind[] @default([])
  multiple Boolean       @default(false)
  choices  Choice[]

  @@map("choice_lists")
}

model Product {
  id               Int              @id @default(autoincrement())
  name             String
  slug             String           @unique
  description      String
  categoryId       Int              @map("category_id")
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  deviceModelId    Int?             @map("device_model_id")
  deviceModel      DeviceModel?     @relation("ProductDeviceModel", fields: [deviceModelId], references: [id], onDelete: Restrict)
  // Facultative : un câble générique n'a pas de marque. Une marque utilisée ne se supprime pas.
  brandId          Int?             @map("brand_id")
  brand            Brand?           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  // Un accessoire : sa marque dans son type (Anker dans Chargeurs). Règle de l'API : la marque
  // appartient au type du produit (`brandId`).
  makerId          Int?             @map("maker_id")
  maker            AccessoryMaker?  @relation(fields: [makerId], references: [id], onDelete: Restrict)
  compatibleModels DeviceModel[]    @relation("ProductCompatibleModels")
  specs            Json             @default("{}")
  status           ProductStatus    @default(draft)
  minPrice         Int              @default(0) @map("min_price")
  newPrice         Int?             @map("new_price")
  createdAt        DateTime         @default(now()) @map("created_at")
  // Le dernier arrivage (12/11) : la création, puis chaque nouvel exemplaire, nouvelle variante ou
  // hausse de stock faits dans le back-office. Les « derniers arrivages » de l'accueil le suivent.
  stockedAt        DateTime         @default(now()) @map("stocked_at")
  variants         ProductVariant[]
  images           ProductImage[]
  orderItems       OrderItem[]

  @@index([status, categoryId, createdAt(sort: Desc)])
  @@index([status, stockedAt(sort: Desc)])
  @@index([status, minPrice])
  @@index([newPrice])
  @@index([categoryId])
  @@index([deviceModelId])
  @@index([brandId])
  @@index([makerId])
  @@map("products")
}

model ProductVariant {
  id               Int           @id @default(autoincrement())
  productId        Int           @map("product_id")
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku              String        @unique
  options          Json          @default("{}")
  price            Int
  stock            Int
  stockedAt        DateTime      @default(now()) @map("stocked_at")
  condition        Condition     @default(new)
  // La fiche d'état d'une affaire (`refurbished`), vide pour un neuf scellé (`new`).
  grade            Int?
  batteryHealth    Int?          @map("battery_health")
  replacedParts    String[]      @default([]) @map("replaced_parts")
  // Les pièces changées qui ne sont pas d'origine (CHECK : une partie de replacedParts).
  compatibleParts  String[]      @default([]) @map("compatible_parts")
  defects          String[]      @default([])
  limitations      String[]      @default([])
  // Avec (true) ou sans (false) sa boîte d'origine. Une affaire importée d'une annonce
  // qui n'en parle pas reste à null (« Boîte non précisée ») ; un neuf scellé est
  // toujours à null, il l'a par définition (CHECK dans la migration).
  withBox          Boolean?      @map("with_box")
  // Les détails du gérant pour le client (« Comme neuf, vendu avec sa boîte d'origine »).
  details          String?
  // La garantie en mois (CHECK : 1 à 36), obligatoire pour un appareil (règle de l'API).
  warrantyMonths   Int?          @map("warranty_months")
  // Le pays d'origine, une valeur de la liste « Pays d'origine » (« Europe »).
  origin           String?
  // La référence interne du magasin (« 51057 »), unique quand elle existe.
  reference        String?       @unique
  // Les téléphones sur lesquels va cette variante d'accessoire (une taille de verre : 6,7 pouces),
  // réglés dans le back-office et montrés par la fenêtre de la Boutique (12/11).
  compatibleModels DeviceModel[] @relation("VariantCompatibleModels")
  // Les articles offerts avec cette variante (neuf scellé ou affaire).
  gifts            VariantGift[] @relation("DealVariant")
  // Les affaires dans lesquelles cette variante est offerte.
  giftedIn         VariantGift[] @relation("GiftVariant")

  @@index([productId])
  @@index([stockedAt(sort: Desc)])
  @@map("product_variants")
}

model VariantGift {
  id            Int            @id @default(autoincrement())
  variantId     Int            @map("variant_id")
  variant       ProductVariant @relation("DealVariant", fields: [variantId], references: [id], onDelete: Cascade)
  giftVariantId Int            @map("gift_variant_id")
  giftVariant   ProductVariant @relation("GiftVariant", fields: [giftVariantId], references: [id], onDelete: Cascade)
  quantity      Int            @default(1)

  @@unique([variantId, giftVariantId])
  @@index([giftVariantId])
  @@map("variant_gifts")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String? @map("public_id")
  position  Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

// La mémoire de l'import des annonces (`npm run import:dropzone`) : pour chaque SKU
// importé, les valeurs de la dernière annonce écrite. Sans lien vers la variante, exprès :
// une ligne survit à la suppression de la variante, et l'import sait alors que le gérant
// l'a retirée (il ne la recrée pas). Au rejeu, seuls les champs dont l'annonce a changé
// depuis cette mémoire sont réécrits : les corrections du gérant restent.
model ImportRecord {
  sku       String   @id
  snapshot  Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("import_records")
}

// ---------- Les comptes ----------

model User {
  id             Int      @id @default(autoincrement())
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  email          String   @unique
  passwordHash   String   @map("password_hash")
  phone          String
  role           Role     @default(customer)
  addressWilaya  String?  @map("address_wilaya")
  addressCommune String?  @map("address_commune")
  addressLine    String?  @map("address_line")
  createdAt      DateTime @default(now()) @map("created_at")
  orders         Order[]

  @@map("users")
}

// ---------- Les commandes ----------

model Order {
  id                  Int         @id @default(autoincrement())
  // Une deuxième séquence, pour le numéro montré au client. Elle commence à 1001
  // (réglé à la main dans la migration add_store_tables).
  number              Int         @unique @default(autoincrement())
  userId              Int?        @map("user_id")
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName            String      @map("full_name")
  phone               String
  wilaya              String
  commune             String
  address             String
  subtotal            Int
  shippingFee         Int         @map("shipping_fee")
  total               Int
  status              OrderStatus @default(pending)
  note                String?
  limitationsAccepted Boolean     @default(false) @map("limitations_accepted")
  createdAt           DateTime    @default(now()) @map("created_at")
  items               OrderItem[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id              Int       @id @default(autoincrement())
  orderId         Int       @map("order_id")
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       Int?      @map("product_id")
  product         Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Recopiés à la commande : une commande est un fait passé.
  sku             String
  name            String
  options         Json      @default("{}")
  condition       Condition @default(new)
  conditionReport String?   @map("condition_report")
  unitPrice       Int       @map("unit_price")
  quantity        Int
  isGift          Boolean   @default(false) @map("is_gift")
  // La garantie de l'appareil au jour de la commande (null pour un accessoire).
  warrantyMonths  Int?      @map("warranty_months")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Les photos du socle de l'accueil (06/11) : le hero (`hero`) et le bandeau des affaires
// (`deal`) ont chacun leurs emplacements fixes (`slot`, liste dans stage.slots.ts). Le gérant y
// envoie ses photos sans fond depuis le back-office (page Accueil) ; un emplacement sans ligne
// garde l'illustration de départ.
model StageSlot {
  id       Int     @id @default(autoincrement())
  stage    String
  slot     String
  url      String?
  label    String?
  publicId String? @map("public_id")
  // La place choisie à la souris ou au doigt (06/11), en % du cadre du socle : `x` le bord
  // gauche, `y` la hauteur du bas de la photo, `w` la largeur ; `z` l'ordre (devant/derrière).
  // Null : la place de départ de l'emplacement (stageLayout.ts du front).
  x        Float?
  y        Float?
  w        Float?
  z        Int?

  @@unique([stage, slot])
  @@map("stage_slots")
}
